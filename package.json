{
  "name": "space-card-game",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter @space/server dev",
    "dev:client": "pnpm --filter @space/client dev",
    "dev:stop": "node scripts/stop-dev.js",
    "db:up": "docker compose up -d --wait db",
    "db:generate": "pnpm --filter @space/server db:generate",
    "docker:up": "docker compose up --build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "typescript": "^5.9.0",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.2"
  }
}
