# Настройки docker-compose.yml (pnpm docker:up, pnpm db:up). Скопируйте в .env (он в .gitignore) и задайте свои значения.

# Пароли базы. POSTGRES_PASSWORD - суперпользователь postgres (обслуживание, тест хранилища), APP_DB_PASSWORD - роль space,
# под которой работает сервер. Только буквы и цифры: пароль подставляется в строку подключения как есть.
# Сгенерировать: openssl rand -hex 24
# Применяются только при первом создании тома с базой (как сменить на существующем - apps/server/README.md, раздел Docker).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Лимиты по адресу клиента (0 - выключены). Под Docker Desktop (Windows, macOS) сервер видит всех игроков с одного адреса
# шлюза Docker, и лимит стал бы общим на всех, поэтому по умолчанию они выключены. Включать на Linux или за прокси,
# который передаёт настоящий адрес клиента.
# MAX_CONNECTIONS_PER_IP=20
# MATCH_STARTS_PER_HOUR=60
