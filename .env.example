# Пароли базы. POSTGRES_PASSWORD - суперпользователь postgres (обслуживание, тест хранилища),
# APP_DB_PASSWORD - роль space, под которой работает сервер.
POSTGRES_PASSWORD=""
APP_DB_PASSWORD=""

# Лимиты по адресу клиента (0 - выключены). Под Docker Desktop (Windows, macOS) сервер видит всех игроков с одного адреса
# шлюза Docker, и лимит стал бы общим на всех, поэтому по умолчанию они выключены. Включать на Linux или за прокси,
# который передаёт настоящий адрес клиента. На боевом сервере за Caddy адрес настоящий, так что их можно включить здесь.
# MAX_CONNECTIONS_PER_IP=20
# MATCH_STARTS_PER_HOUR=60

# Боевой сервер (раскомментировать только там): домен для сертификата Let's Encrypt и подключение
# docker-compose.prod.yml (Caddy с HTTPS), чтобы docker compose работал без ключей -f.
# Пароли базы выше генерируйте через `openssl rand -hex 24`: они попадают в строку подключения, и символы @ : / # её сломают.
# DOMAIN=star-realms.arkeviz.ru
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
