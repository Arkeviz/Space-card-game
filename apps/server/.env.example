# Скопируйте в .env (он в .gitignore): `pnpm dev` подхватывает его сам (node --env-file-if-exists).
# Без DATABASE_URL сервер работает, но партии живут только в памяти и пропадают при перезапуске.

PORT=3001
# База из docker-compose.yml (`pnpm db:up`). CHANGE_ME - APP_DB_PASSWORD из корневого .env.
DATABASE_URL=postgres://space:CHANGE_ME@localhost:5432/space
# Сколько дней партии хранятся после последнего изменения.
MATCH_RETENTION_DAYS=14

# Лимиты по адресу клиента (0 - выключены). По умолчанию 20 соединений и 60 новых матчей в час с одного адреса.
# MAX_CONNECTIONS_PER_IP=20
# MATCH_STARTS_PER_HOUR=60
# Каким прокси верить в X-Forwarded-For (адреса, подсети, uniquelocal, loopback). Без прокси не задавать.
# TRUST_PROXY=loopback
