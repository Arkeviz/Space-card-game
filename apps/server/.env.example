# Скопируйте в .env (он в .gitignore): `pnpm dev` подхватывает его сам (node --env-file-if-exists).
# Без DATABASE_URL сервер работает, но партии живут только в памяти и пропадают при перезапуске.

PORT=3001
# База из docker-compose.yml (`pnpm db:up`).
DATABASE_URL=postgres://space:space@localhost:5432/space
# Сколько дней партии хранятся после последнего изменения.
MATCH_RETENTION_DAYS=14
